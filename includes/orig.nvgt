drumsnare:2:20
drumkick2:1:30");
b.add("3ccommand","3c:4:51
drumsnare:2:20
drumkick2:1");
b.add("passit","passit:4:80
tone1:2
tone2:2
tone3:2
tone2:2
tone1:2
tone4:2:80");
}
void set_speeds()
{
speeds.resize(0);
speeds.insert_last({100,96,88,80,70});
min_speed_interval=2;
max_speed_interval=7;
}
void wait_loop()
{
bopit::wait_loop();
for (uint i=0; i<commands.length(); i++)
{
if (commands[i].name==2 and key_pressed(commands[i].key))
{
if (!power)
{
power=true;
mode=3;
}
mode++;
if (mode>3)
mode=1;
if (mode==1)
{
beatbop=false;
passit=true;
play("1b",hard_wait=true);
}
else if (mode==2)
{
beatbop=true;
passit=true;
play("3b",hard_wait=true);
}
else if (mode==3)
{
beatbop=false;
passit=false;
play("2b",hard_wait=true);
}
}
if (commands[i].name==3 and key_pressed(commands[i].key) and power and mode==3)
{
play_score();
}
if (commands[i].name==1 and key_pressed(commands[i].key) and power)
{
start_game();
return;
}
}
}
void win()
{
wait_for_beat();
wait(2000);
play_score();
speed_index=0;
}

}
