void wait_loop()
{
bopit::wait_loop();
for (uint i=0; i<commands.length(); i++)
{
if (commands[i].name==2 and key_pressed(commands[i].key))
{
if (!power)
{
power=true;
mode=2;
}
mode++;
if (mode>2)
mode=1;
if(beatbop) {
play("bb",hard_wait=true);
}
else{
play("vb",hard_wait=true);
}
if (mode==1)
{
passit=false;
play("solo",hard_wait=true);
}
else if (mode==2)
{
passit=true;
play("passit",hard_wait=true);
}
}
if (commands[i].name==5 and key_pressed(commands[i].key))
{
if(beatbop) {
beatbop=false;
play("vb",hard_wait=true);
}
else{
beatbop=true;
play("bb",hard_wait=true);
}
}
if (commands[i].name==3 and key_pressed(commands[i].key) and power and mode==1)
{
play("hs",hard_wait=true);
wait(150/pitchmod);
play_score(highscore);
}
if (commands[i].name==1 and key_pressed(commands[i].key) and power)
{
current_beat=0;
start_game();
return;
}
}
}
void lose()
{
int give_comment=random(1,20);
if (!passit)
score=working_score;
timeout=default_timeout;
speedup=0;
pass=0;
b.stop();
if(score<150 or mode!=1) {
play("ouch",hard_wait=true);
}
if(mode==1) {
if(speed_index==1 and current_beat==0) {
b.play("losesolo1_alt");
}
else {
b.play("losesolo"+(current_beat+1));
}
wait_for_beat();
wait(50/pitchmod);
}
if(give_comment>5) {
if(mode==1 and score>highscore) {
play("good"+random(1,3),hard_wait=true);
}
else {
play("bad"+random(1,7),hard_wait=true);
}
}
if(mode==1 and score>0) {
if(score>highscore) {
highscore=score;
save_value("highscore",highscore);
play("hs",hard_wait=true);
wait(50/pitchmod);
}
else {
play("score",hard_wait=true);
}
play_score(score);
}
else if(mode==2) {
play("out",hard_wait=true);
}
speed_index=0;
}
void play_score(int value)
{
number_speaker score_reader;
score_reader.prepend="sounds/extreme2/";
score_reader.append=".flac";
score_reader.speak_wait(value);
}
void handle_speedup()
{
speedup++;
if (speedup>=speed_interval)
{
speedup=0;
set_speed_interval();
current_beat++;
if (speed_index<speeds[3].length()-1 and current_beat>=4)
{
speed_index++;
timeout-=40;
if (timeout<=40)
timeout=40;
current_beat=0;
}
b.play("start"+(current_beat+1));
wait_for_beat();
}
}
void play_command()
{
b.play(current_command.name+(beatbop==true?"c":"")+"command"+(current_beat+1));
}
void play_response()
{
b.stop();
b.play(current_command.name+"bcommand"+(current_beat+1));
}
void start_game()
{
b.play("start"+(current_beat+1));
working_score=0;
if (!passit)
score=0;
if (passit)
set_pass_interval();
set_speed_interval();
in_game=true;
speedup=-1;
}
void handle_passit()
{
pass=0;
wait_for_beat();
b.play("passit"+(current_beat+1));
wait_for_beat();
b.play("start"+(current_beat+1));
}
void check_win()
{
if (working_score>=max_score and mode==1)
{
win();
score=working_score;
in_game=false;
}
}
void win() {
wait_for_beat();
b.play("losesolo4");
wait_for_beat();
highscore=score;
save_value("highscore",highscore);
play("hs", hard_wait=true);
wait(100);
play_score(250);
}
}