drumsnare:2
drumkickshort:1
drumkickshort:1");
b.add("1ccommand","1c:4
drumsnare:2
drumkickshort:1
drumkickshort:1");
b.add("2command","2:4
drumsnare:2
drumkick:2");
b.add("2bcommand","2b:4
drumsnare:2
drumkickshort:1
drumkickshort:1");
b.add("2bcommand_alt","2b:4
drumsnare:2
drumkickshort:1:30");
b.add("2ccommand","2c:4
drumsnare:2
drumkickshort:1
drumkickshort:1");
