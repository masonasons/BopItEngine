}
void wait_loop()
{
bopit::wait_loop();
for (uint i=0; i<commands.length(); i++)
{
if (commands[i].name==2 and key_pressed(commands[i].key))
{
if (!power)
{
power=true;
mode=4;
}
mode++;
if (mode>4)
mode=1;
if (mode==1)
{
beatbop=false;
passit=true;
play("vb",hard_wait=true);
}
else if (mode==2)
{
beatbop=true;
passit=true;
play("bb",hard_wait=true);
}
else if (mode==3)
{
beatbop=false;
passit=false;
play("vb",hard_wait=true);
play("solo",hard_wait=true);
}
else if (mode==4)
{
beatbop=true;
passit=false;
play("bb",hard_wait=true);
play("solo",hard_wait=true);
}
}
if (commands[i].name==3 and key_pressed(commands[i].key) and power and (mode==3 or mode==4))
{
play("hsv",hard_wait=true);
wait(150/pitchmod);
play_score(highscore);
}
if (commands[i].name==1 and key_pressed(commands[i].key) and power)
{
start_game();
return;
}
}
}
void play_response()
{
b.stop();
if(speed_index==3 and current_command.name==2) {
b.play(current_command.name+"bcommand_alt");
}
else {
b.play(current_command.name+"bcommand");
}
}
void lose()
{
int give_comment=random(1,20);
bopit::lose();
if((mode==3 or mode==4) and score>=150) {
play("fail150",hard_wait=true);
}
else {
play("ouch",hard_wait=true);
}
if ((mode==3 or mode==4) and score<150)
{
if(score>highscore) {
play("hsjingle1",hard_wait=true);
wait(50/pitchmod);
if(give_comment>5) {
play("good"+random(1,2),hard_wait=true);
}
play("hsjingle2",hard_wait=true);
wait(50/pitchmod);
}
play("losesolo",hard_wait=true);
wait(50/pitchmod);
if(score<highscore and give_comment>5) {
play("bad"+random(1,6),hard_wait=true);
}
}
if((mode==3 or mode==4) and score>0) {
if(score>highscore) {
{
highscore=score;
save_value("highscore",highscore);
}
play("hsv",hard_wait=true);
wait(150/pitchmod);
}
else {
play("score",hard_wait=true);
wait(50);
}
play_score(score);
}
else if(mode==1 or mode==2) {
if(give_comment>5) {
wait(75/pitchmod);
play("good"+random(1,2),hard_wait=true);
}
wait(100/pitchmod);
play("out",hard_wait=true);
}
}
void play_score(int value)
{
int hundreds=floor(value/100);
int tens=floor(value/10);
if (tens>=20)
tens-=20;
if (tens>=10)
tens-=10;
int ones=value-(hundreds*100)-(tens*10);
for (uint i=1; i<=hundreds; i++)
{
play("2b");
wait(550/pitchmod);
}
for (uint i=1; i<=tens; i++)
{
play("3b");
wait(550/pitchmod);
}
for (uint i=1; i<=ones; i++)
{
play("1b");
wait(700/pitchmod);
}
}
void check_win()
{
if (working_score>=max_score and (mode==3 or mode==4))
{
win();
score=working_score;
in_game=false;
}
}
void win()
{
wait_for_beat();
play("win",hard_wait=true);
highscore=score;
save_value("highscore",highscore);
play("hsv",hard_wait=true);
play_score(200);
wait(500);
play_score(50);
speed_index=0;
}

}
class bopit_extreme_uk:bopit_extreme
{
bopit_extreme_uk(string name)
{
super(name,"sounds/extreme_uk");
}
void set_speeds()
{
speeds.insert_last({115,107,100, 92, 85});
min_speed_interval=8;
max_speed_interval=20;
}
}