class bopit_extreme:bopit
{
int highscore=0;
bopit_extreme(string name, string sounds="sounds/extreme")
{
super(name,true,sounds);
highscore=sd["highscore",0];
set_speeds();
default_timeout=150;
max_score=250;
timeout=150;
add_sounds();
add_commands();
add_beats();
}
void add_sounds()
{
add_sounds({"1", "1b", "1c", "2", "2b", "2c", "3", "3b", "3c", "4", "4b", "4c", "5", "5b", "5c", "losesolo", "ouch", "fail150", "passit", "tone1", "tone2", "tone3", "tone4", "out", "win", "score", "hsv", "hsjingle1", "hsjingle2", "vb", "bb", "solo", "bad1", "bad2", "bad3", "bad4", "bad5", "bad6", "good1", "good2",});
b.add_sounds({"1", "1b", "1c", "2", "2b", "2c", "3", "3b", "3c", "4", "4b", "4c", "5", "5b", "5c", "drumkick", "drumkickshort", "drumkickbell", "drumsnare", "passit", "tone1", "tone2", "tone3", "tone4"});
}
void add_commands()
{
add_command(command(1,KEY_DOWN));
add_command(command(2,KEY_LEFT));
add_command(command(3,KEY_RIGHT));
add_command(command(4,KEY_RETURN));
add_command(command(5,KEY_UP));
}
void set_speeds()
{
speeds.insert_last({115,107,100, 92, 85});
min_speed_interval=8;
max_speed_interval=20;
}
void add_beats()
{
