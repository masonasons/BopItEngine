class command
{
string name;
int key;
command(string name, int key)
{
this.name=name;
this.key=key;
}
}
class bopit
{
bool autopilot=false;
int autopilotlevel=1;
int autopilottime;
double pitchmod=1.00;
bool save;
string name;
bool beatbop=false;
bool power=false;
bool passit=false;
int pass=0;
int timeout;
int default_timeout;
int mode=0;
int score=0;
int high_score=0;
bool playing_sound=false;
bool in_game=false;
int[] speeds;
int speed_index=0;
int speedup=0;
int speed_interval;
beat@ b;
int max_score=100;
string soundpath;
dictionary sounds;
command@[] commands;
command@ current_command;
timer autopilottimer, waittimer;
savedata@ sd;
bopit(string name, bool save=false)
{
this.save=save;
this.name=name;
@b=beat(@this);
if (save)
{
if (OS==OS_DARWIN and !directory_exists(DIRECTORY_APPDATA+"/BopItEngine"))
directory_create(DIRECTORY_APPDATA+"/BopItEngine");
if (!directory_exists(OS==OS_DARWIN?DIRECTORY_APPDATA+"/BopItEngine/":""+"config"))
directory_create(OS==OS_DARWIN?DIRECTORY_APPDATA+"/BopItEngine/":""+"config");
@sd=savedata(OS==OS_DARWIN?DIRECTORY_APPDATA+"/BopItEngine/":""+"config/"+name+".dat");
sd.load();
}
}
void loop()
{
b.loop();
sound_loop();
if (in_game==false)
wait_loop();
else
game_loop();
if (key_pressed(KEY_A))
{
autopilot=autopilot==true?false:true;
speak("Autopilot "+(autopilot==true?"on":"off"));
set_autopilottime();
}
if (key_pressed(KEY_S))
{
autopilotlevel++;
if (autopilotlevel>=5)
autopilotlevel=1;
set_autopilottime();
speak("Autopilot Level "+autopilotlevel);
}
if (key_pressed(KEY_0))
{
pitchmod=1;
speak(100);
}
if (key_repeating(KEY_DASH))
{
pitchmod-=key_down(KEY_LMENU) or key_down(KEY_RMENU)?0.1:0.01;
speak(round(100*pitchmod,0));
}
if (key_repeating(KEY_EQUALS))
{
pitchmod+=key_down(KEY_LMENU) or key_down(KEY_RMENU)?0.1:0.01;
speak(round(100*pitchmod,0));
}
}
void game_loop()
{
if (!b.playing and @current_command==null)
{
new_command();
play_command();
if (command_loop())
{
if (passit==false)
score++;
b.stop();
b.play(current_command.name+"bcommand");
@current_command=null;
speedup++;
if (passit)
pass++;
if (pass>=random(5,15))
{
pass=0;
while (b.playing)
{
wait(5);
b.loop();
}
b.play("passit");
while (b.playing)
{
wait(5);
b.loop();
}
b.play("start");
}
if (speedup>=speed_interval)
{
speedup=0;
if (speed_index<speeds.length()-1)
{
speed_index++;
timeout-=40;
}
}
}
else
{
@current_command=null;
lose();
in_game=false;
}
}
}
void wait_loop()
{
}
void sound_loop()
{
bool playing=false;
for (uint i=0; i<sounds.get_size(); i++)
{
sound@ h;
if (!sounds.get(sounds.get_keys()[i],@h))
continue;
if (h.playing)
playing=true;
}
if (!playing)
playing_sound=false;
}
void stop_sounds()
{
for (uint i=0; i<sounds.get_size(); i++)
{
sound@ h;
if (!sounds.get(sounds.get_keys()[i],@h))
continue;
h.stop();
}
}
bool command_loop()
{
waittimer.restart();
autopilottimer.restart();
while(waittimer.elapsed<=timeout/pitchmod)
{
wait(5);
sound_loop();
b.loop();
if (b.playing or playing_sound)
waittimer.restart();
if (autopilottimer.elapsed>=autopilottime and autopilot)
{
autopilottimer.restart();
set_autopilottime();
return true;
}
for (uint i=0; i<commands.length(); i++)
{
if (key_pressed(commands[i].key))
{
if (@current_command==@commands[i])
return true;
else
return false;
}
}
}
return false;
}
void add_sound(string soundname)
{
sound s;
s.load(soundpath+"/"+soundname+".flac");
sounds[soundname]=@s;
}
void add_sounds(string[] snds)
{
for (uint i=0; i<snds.length(); i++)
add_sound(snds[i]);
}
void add_command(command@ command)
{
commands.insert_last(@command);
}
void play(string name, bool wait=true, bool stop=true, bool hard_wait=false)
{
if (stop)
stop_sounds();
sound@ h;
if (sounds.get(name, @h))
{
h.pitch=100*pitchmod;
h.seek(0);
if (!hard_wait)
h.play();
else
h.play_wait();
if (wait)
playing_sound=true;
}
}
void play_command()
{
b.play(current_command.name+(beatbop==true?"c":"")+"command");
}
void start_game()
{
b.play("start");
if (passit==false)
score=0;
in_game=true;
}
void new_command()
{
@current_command=@commands[random(0,commands.length()-1)];
}
int get_speed() property
{
return speeds[speed_index];
}
void lose()
{
timeout=default_timeout;
speedup=0;
speed_index=0;
pass=0;
b.stop();
}
void play_score()
{
}
void save_value(string name, int value)
{
if (!save)
return;
sd.add(name,value);
sd.save();
}
void save_value(string name, string value)
{
if (!save)
return;
sd.add(name,value);
sd.save();
}
void set_autopilottime()
{
autopilottime=(random(650,800)/autopilotlevel)/pitchmod;
}
}