class command
{
string name;
int key;
bool issue=true;
command(string name, int key, bool issue=true)
{
this.name=name;
this.key=key;
this.issue=issue;
}
}
class bopit
{
int current_beat=0;
bool autopilot=false;
int autopilotlevel=1;
int autopilottime;
double pitchmod=1.00;
bool save;
string name;
int min_pass_interval=5;
int max_pass_interval=15;
int pass_interval=0;
int min_speed_interval=4;
int max_speed_interval=4;
bool beatbop=false;
bool power=false;
bool passit=false;
bool supports_oneonone=false;
bool oneonone=false;
string bopit_command=1;
string bopit_command2=4;
int pass=0;
int timeout;
int default_timeout;
int mode=0;
int score=0;
int working_score=0;
int high_score=0;
bool playing_sound=false;
bool in_game=false;
int[][] speeds;
int speed_index=0;
int speedup=0;
int speed_interval;
beat@ b;
int max_score=100;
string soundpath;
dictionary sounds;
command@[] commands;
command@ current_command;
timer autopilottimer, waittimer;
savedata@ sd;
bopit(string name, bool save=false, string soundpath="")
{
this.soundpath=soundpath;
this.save=save;
this.name=name;
@b=beat(@this);
if (save)
{
@sd=savedata(get_preferences_path("masonasons.me","BopItEngine")+"/"+name+".dat");
sd.load();
}
}
void loop()
{
b.loop();
sound_loop();
if (in_game==false)
wait_loop();
else
game_loop();
if (key_pressed(KEY_A))
{
autopilot=autopilot==true?false:true;
speak("Autopilot "+(autopilot==true?"on":"off"));
set_autopilottime();
}
if (key_pressed(KEY_S))
{
autopilotlevel++;
if (autopilotlevel>=5)
autopilotlevel=1;
set_autopilottime();
speak("Autopilot Level "+autopilotlevel);
}
if (key_pressed(KEY_0))
{
pitchmod=1;
speak(100);
}
if (key_repeating(KEY_DASH) and pitchmod>0.05)
{
pitchmod-=key_down(KEY_LMENU) or key_down(KEY_RMENU)?0.1:0.01;
if (pitchmod<0.05)
pitchmod=0.05;
speak(round(100*pitchmod,0));
}
if (key_repeating(KEY_EQUALS))
{
pitchmod+=key_down(KEY_LMENU) or key_down(KEY_RMENU)?0.1:0.01;
speak(round(100*pitchmod,0));
}
}
void game_loop()
{
if (!b.playing and @current_command==null)
{
handle_speedup();
new_command();
play_command();
if (command_loop())
{
working_score++;
play_response();
@current_command=null;
check_win();
if (passit)
pass++;
if (pass>=random(min_pass_interval,max_pass_interval))
{
handle_passit();
}
}
else
{
@current_command=null;
lose();
in_game=false;
}
}
}
void wait_for_beat()
{
while (b.playing)
{
wait(5);
b.loop();
sound_loop();
}
}
void wait_loop()
{
}
void sound_loop()
{
bool playing=false;
for (uint i=0; i<sounds.get_size(); i++)
{
sound@ h;
if (!sounds.get(sounds.get_keys()[i],@h))
continue;
if (h.playing)
playing=true;
}
if (!playing)
playing_sound=false;
}
void stop_sounds()
{
for (uint i=0; i<sounds.get_size(); i++)
{
sound@ h;
if (!sounds.get(sounds.get_keys()[i],@h))
continue;
h.stop();
}
}
bool command_loop()
{
waittimer.restart();
autopilottimer.restart();
while(waittimer.elapsed<=timeout/pitchmod)
{
wait(5);
touch.monitor();
sound_loop();
b.loop();
if (b.playing or playing_sound)
waittimer.restart();
if (autopilottimer.elapsed>=autopilottime and autopilot)
{
autopilottimer.restart();
set_autopilottime();
return true;
}
for (uint i=0; i<commands.length(); i++)
{
if (key_pressed(commands[i].key))
{
if (@current_command==@commands[i] or supports_oneonone==true and current_command.name==bopit_command and (commands[i].name==bopit_command or commands[i].name==bopit_command2))
return true;
else
return false;
}
}
}
return false;
}
void add_sound(string soundname)
{
sound s;
s.load(soundpath+"/"+soundname+".flac");
sounds[soundname]=@s;
}
void add_sounds(string[] snds)
{
for (uint i=0; i<snds.length(); i++)
add_sound(snds[i]);
}
void add_command(command@ command)
{
commands.insert_last(@command);
}
void play(string name, bool wait=true, bool stop=true, bool hard_wait=false)
{
if (stop)
stop_sounds();
sound@ h;
if (sounds.get(name, @h))
{
h.pitch=100*pitchmod;
h.seek(0);
if (!hard_wait)
h.play();
else
h.play_wait();
if (wait and !hard_wait)
playing_sound=true;
}
}
void play_command()
{
b.play(current_command.name+(beatbop==true?"c":"")+"command");
}
void start_game()
{
b.play("start");
working_score=0;
if (!passit)
score=0;
if (passit)
set_pass_interval();
set_speed_interval();
in_game=true;
}
void new_command()
{
@current_command=@commands[random(0,commands.length()-1)];
while (!current_command.issue)
@current_command=@commands[random(0,commands.length()-1)];
}
int get_speed() property
{
return speeds[current_beat][speed_index];
}
void lose()
{
if (!passit)
score=working_score;
timeout=default_timeout;
speedup=0;
speed_index=0;
pass=0;
b.stop();
}
void win()
{
}
void play_score()
{
}
void save_value(string name, int value)
{
if (!save)
return;
sd.add(name,value);
sd.save();
}
void save_value(string name, string value)
{
if (!save)
return;
sd.add(name,value);
sd.save();
}
void set_autopilottime()
{
autopilottime=((speeds[current_beat][speed_index]+random(-10,10))*8/autopilotlevel)/pitchmod;
}
void set_pass_interval()
{
pass_interval=random(min_pass_interval,max_pass_interval);
}
void set_speed_interval()
{
speed_interval=random(min_speed_interval,max_speed_interval);
}
void handle_speedup()
{
speedup++;
if (speedup>=speed_interval)
{
speedup=0;
set_speed_interval();
if (speed_index<speeds[current_beat].length()-1)
{
speed_index++;
timeout-=40;
if (timeout<=40)
timeout=40;
}
}
}
void handle_passit()
{
pass=0;
wait_for_beat();
b.play("passit");
wait_for_beat();
b.play("start");
}
void play_response()
{
b.stop();
b.play(current_command.name+"bcommand");
}
void check_win()
{
if (working_score>=max_score)
{
win();
score=working_score;
in_game=false;
}
}
}